# https://… in production: sign-in cookies are only marked Secure when it is.
BASE_URL=http(s)://
JWT_SECRET=
# Shortcodes with access to /admin.
WEBMASTERS=shortcode,shortcode
# Emails are only sent when this is production; otherwise they are written to the log.
NODE_ENV=production

PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=
PGDB=
# The database's CA certificate, if it requires TLS (DigitalOcean's managed Postgres does).
PGCA=

NODEMAILER_HOST=smtp-mail.outlook.com
NODEMAILER_PORT=587
NODEMAILER_USER=
NODEMAILER_PASS=
# The address emails come from. Leave empty to use NODEMAILER_USER; it must be an address that
# account may send as, on a domain whose SPF and DKIM allow it.
MAIL_FROM=
# The name emails come from. Leave empty for none; avoid anything with "DoCSoc" in it, which
# Imperial's filter treats as impersonating its own docsoc@ic.ac.uk.
MAIL_FROM_NAME=

ABC_API_BASE=https://abc-api.doc.ic.ac.uk
ABC_API_USER=docsoc
ABC_API_PASS=

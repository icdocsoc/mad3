{
  "title": "Mums and Dads: parents",
  "version": 2,
  "audience": "returning",
  "closed": {
    "title": "Not open yet",
    "body": "Parents' sign-ups have not started. We will email you when they do."
  },
  "notForYou": {
    "title": "This one is for parents",
    "body": "Parents are students in their second year or later. If you are a first year, the freshers' survey is the one for you."
  },
  "stages": [
    {
      "id": "you",
      "title": "Hello my name is...",
      "blurb": "This is how we'll introduce you to your family once you're matched. Nobody else sees it.",
      "fields": {
        "name": {
          "kind": "text",
          "label": "Full name",
          "hint": "Nicolas Wu"
        },
        "preferredName": {
          "kind": "text",
          "label": "Preferred name",
          "hint": "Nick",
          "optional": true
        },
        "shortcode": {
          "kind": "text",
          "label": "Imperial shortcode",
          "hint": "nw1926"
        },
        "course": {
          "kind": "choice",
          "label": "Course",
          "hint": "Computing and JMC timetables clash.",
          "options": [
            {
              "value": "computing",
              "label": "Computing"
            },
            {
              "value": "jmc",
              "label": "Joint Maths and Computing"
            }
          ]
        }
      }
    },
    {
      "id": "why",
      "title": "How this works",
      "fields": {
        "why": {
          "kind": "note",
          "label": "How this works",
          "body": "Your answers go into a deterministic matchmaking algorithm, which gives you and your partner a few freshers as your kids. That's all your answers are used for.\nOnce you're matched, your profile is shared with your kids."
        }
      }
    },
    {
      "id": "commute",
      "title": "During term I live...",
      "blurb": "So we understand how easy it is for you to get to campus.",
      "fields": {
        "commute": {
          "kind": "choice",
          "label": "During term I live...",
          "hint": "So we understand how easy it is for you to get to campus.",
          "options": [
            {
              "value": "halls",
              "label": "Minutes from campus"
            },
            {
              "value": "nearby",
              "label": "Living around West London"
            },
            {
              "value": "commute",
              "label": "Living in London"
            },
            {
              "value": "far",
              "label": "Commuting from further out"
            }
          ]
        }
      }
    },
    {
      "id": "gender",
      "title": "I identify as a...",
      "fields": {
        "gender": {
          "kind": "choice",
          "label": "I identify as a...",
          "optional": true,
          "options": [
            {
              "value": "male",
              "label": "Male"
            },
            {
              "value": "female",
              "label": "Female"
            },
            {
              "value": "self-describe",
              "label": "I am...",
